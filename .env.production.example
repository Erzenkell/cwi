# Copier ce fichier vers .env.production et remplacer toutes les valeurs CHANGE_ME.
APP_PORT=8080
APP_ORIGIN=https://crm.example.com

POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS

# Utilisés uniquement par la commande d'initialisation du premier administrateur.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_USE_AT_LEAST_12_CHARACTERS
ADMIN_FULL_NAME=Administrateur CRM
